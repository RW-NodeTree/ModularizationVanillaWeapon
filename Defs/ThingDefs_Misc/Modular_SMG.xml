<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>Gun_ModularMachinePistol</defName>
		<label>modular machine pistol</label>
		<description>A micro-submachine gun. It is short-ranged, but very light in the hands. Its rate of fire tends to make up for its weakness.</description>
		<thingClass>RW_ModularizationWeapon.ModularizationWeapon</thingClass>
		<graphicData>
			<texPath>Things/WeaponPart/Gun/MachinePistol/MachinePistol</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.4</uiIconScale>
		<soundInteract>Interact_SMG</soundInteract>
		<weaponClasses>
			<li>RangedLight</li>
			<li>ShortShots</li>
		</weaponClasses>
		<weaponTags>
			<li>ShortShots</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>BlowbackOperation</researchPrerequisite>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
			<displayPriority>410</displayPriority>
		</recipeMaker>
		<statBases>
			<WorkToMake>11000</WorkToMake>
			<Mass>2.5</Mass>
			<AccuracyTouch>0.90</AccuracyTouch>
			<AccuracyShort>0.65</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.15</AccuracyLong>
			<RangedWeapon_Cooldown>3.6</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>45</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_MachinePistol</defaultProjectile>
				<warmupTime>0.5</warmupTime>
				<range>19.9</range>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
				<soundCast>Shot_MachinePistol</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>

		<modExtensions>
			<li Class="RW_ModularizationWeapon.ModularizationWeaponExtension">
				<TextureSizeFactor>256</TextureSizeFactor>
				<TextureFilterMode>Point</TextureFilterMode>
				<ExceedanceFactor>2</ExceedanceFactor>
				<ExceedanceOffset>1</ExceedanceOffset>
				<setRandomPartWhenCreate>true</setRandomPartWhenCreate>
				<outlineWidth>8</outlineWidth>
				<outlineWidthInPixelSize>true</outlineWidthInPixelSize>
				<attachmentProperties>
					<li>
						<id>ModMP_Magazine</id>
						<name>magazine</name>
						<UITexPath>ui/icons/AttachmentIcon/AttachmentIcon_Mag</UITexPath>
						<postion>(0,0.1,0.00390625)</postion>
						<defultThing>Module_HvySMG_MagClip</defultThing>
						<allowEmpty>true</allowEmpty>
						<randomToEmptyWeight>0</randomToEmptyWeight>
						<filterWithWeights>
							<Module_HvySMG_MagClip>1</Module_HvySMG_MagClip>
							<Module_HvySNG_MagDrum>1</Module_HvySNG_MagDrum>
						</filterWithWeights>
					</li>
					<li>
						<id>ModMP_Stock</id>
						<name>stock</name>
						<UITexPath>ui/icons/AttachmentIcon/AttachmentIcon_Stock</UITexPath>
						<postion>(-0.5,-0.1,0.03125)</postion>
						<allowEmpty>true</allowEmpty>
						<filterWithWeights>
							<Module_HvySMG_WireStock>1</Module_HvySMG_WireStock>
							<Module_HvySMG_Stock>1</Module_HvySMG_Stock>
						</filterWithWeights>
					</li>
					<li>
						<id>ModMP_Sight</id>
						<name>sight</name>
						<UITexPath>ui/icons/AttachmentIcon/AttachmentIcon_Scope</UITexPath>
						<postion>(0,0.1,0.02734375)</postion>
						<allowEmpty>true</allowEmpty>
						<filterWithWeights>
							<Module_ACOG>1</Module_ACOG>
							<Module_HoloSight>1</Module_HoloSight>
							<Module_RedDotSight>1</Module_RedDotSight>
							<Module_SniperScope>1</Module_SniperScope>
						</filterWithWeights>
					</li>
					<li>
						<id>ModMP_Receiver</id>
						<name>chamber</name>
						<UITexPath>ui/icons/AttachmentIcon/AttachmentIcon_Receiver</UITexPath>
						<postion>(0,0.1,0)</postion>
						<allowEmpty>true</allowEmpty>
						<filterWithWeights>
							<Module_HvySMG_Chamber>1</Module_HvySMG_Chamber>
						</filterWithWeights>
					</li>
					<li>
						<id>ModMP_Muzzle</id>
						<name>muzzle</name>
						<UITexPath>ui/icons/AttachmentIcon/AttachmentIcon_Muzzle</UITexPath>
						<postion>(0.375,0.1,0.0390625)</postion>
						<allowEmpty>true</allowEmpty>
						<filterWithWeights>
							<Module_Silencer>1</Module_Silencer>
							<Module_MuzzleBrake>1</Module_MuzzleBrake>
							<Module_MuzzleCompensator>1</Module_MuzzleCompensator>
							<Module_FlashHider>1</Module_FlashHider>
						</filterWithWeights>
					</li>
				</attachmentProperties>
			</li>
		</modExtensions>
	</ThingDef>

	
	<ThingDef ParentName="BaseHumanMakeableGun">
